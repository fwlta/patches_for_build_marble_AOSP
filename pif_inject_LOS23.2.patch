+
+package com.android.server.spoof;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.os.Binder;
+import android.os.Process;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.JsonReader;
+import android.util.Log;
+
+import com.android.server.NtServiceInjector;
+
+import java.io.StringReader;
+
+public class AxSpoofManager implements IAxSpoofManager {
+    private static final String TAG = "AxSpoofManager";
+    private static final String GMS_PACKAGE = "com.google.android.gms";
+    private static final String PHOTOS_PACKAGE = "com.google.android.apps.photos";
+    private static final String VENDING_PACKAGE = "com.android.vending";
+
+    private Context mContext;
+    private ContentResolver mResolver;
+
+    @Override
+    public void systemReady() {
+        mContext = NtServiceInjector.getCtx();
+        if (mContext == null) {
+            Log.w(TAG, "Context unavailable, deferring init");
+            return;
+        }
+        mResolver = mContext.getContentResolver();
+        Log.i(TAG, "AxSpoofManager ready");
+    }
+
+    private static boolean isPrivilegedUid(int uid) {
+        return uid == Process.ROOT_UID || uid == Process.SYSTEM_UID;
+    }
+
+    private String[] getPackagesForUid(int uid) {
+        if (mContext == null) {
+            return null;
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return mContext.getPackageManager().getPackagesForUid(uid);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    private static boolean containsPackage(String[] packages, String expectedPackage) {
+        if (packages == null || expectedPackage == null) {
+            return false;
+        }
+        for (String packageName : packages) {
+            if (expectedPackage.equals(packageName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private String readForUid(String key, int uid) {
+        if (mResolver == null) {
+            return null;
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return Settings.Secure.getStringForUser(
+                    mResolver, key, UserHandle.getUserId(uid));
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public String getPifConfig(int callingUid) {
+        final String[] packages = getPackagesForUid(callingUid);
+        if (!isPrivilegedUid(callingUid)
+                && !containsPackage(packages, GMS_PACKAGE)
+                && !containsPackage(packages, VENDING_PACKAGE)) {
+            return null;
+        }
+        return readForUid(Settings.Secure.SPOOF_PIF_CONFIG, callingUid);
+    }
+
+    @Override
+    public String getPifSpoofPhotos(int callingUid) {
+        if (!isPrivilegedUid(callingUid)
+                && !containsPackage(getPackagesForUid(callingUid), PHOTOS_PACKAGE)) {
+            return null;
+        }
+        return readForUid(Settings.Secure.SPOOF_PIF_PHOTOS, callingUid);
+    }
+
+    @Override
+    public String getGamePropsConfig(int callingUid) {
+        final String content = readForUid(Settings.Secure.SPOOF_GAMEPROPS_CONFIG, callingUid);
+        if (isPrivilegedUid(callingUid)
+                || isGamePropsTarget(content, getPackagesForUid(callingUid))) {
+            return content;
+        }
+        return null;
+    }
+
+    @Override
+    public String getTrickyStoreTarget(int callingUid) {
+        final String content = readForUid(Settings.Secure.SPOOF_TRICKYSTORE_TARGET, callingUid);
+        if (isPrivilegedUid(callingUid)
+                || isTrickyStoreTarget(content, getPackagesForUid(callingUid))) {
+            return content;
+        }
+        return null;
+    }
+
+    @Override
+    public String getTrickyStoreKeyBox(int callingUid) {
+        if (!canAccessTrickyStore(callingUid)) {
+            return null;
+        }
+        return readForUid(Settings.Secure.SPOOF_TRICKYSTORE_KEYBOX, callingUid);
+    }
+
+    @Override
+    public String getTrickyStorePatch(int callingUid) {
+        if (!canAccessTrickyStore(callingUid)) {
+            return null;
+        }
+        return readForUid(Settings.Secure.SPOOF_TRICKYSTORE_PATCH, callingUid);
+    }
+
+    private boolean canAccessTrickyStore(int callingUid) {
+        if (isPrivilegedUid(callingUid)) {
+            return true;
+        }
+        final String targets = readForUid(
+                Settings.Secure.SPOOF_TRICKYSTORE_TARGET, callingUid);
+        return isTrickyStoreTarget(targets, getPackagesForUid(callingUid));
+    }
+
+    private static boolean isGamePropsTarget(String content, String[] packages) {
+        if (TextUtils.isEmpty(content) || packages == null) {
+            return false;
+        }
+        try (JsonReader reader = new JsonReader(new StringReader(content))) {
+            reader.beginObject();
+            while (reader.hasNext()) {
+                if (!"games".equals(reader.nextName())) {
+                    reader.skipValue();
+                    continue;
+                }
+                reader.beginObject();
+                while (reader.hasNext()) {
+                    final String packageName = reader.nextName();
+                    final boolean matches = containsPackage(packages, packageName);
+                    reader.skipValue();
+                    if (matches) {
+                        return true;
+                    }
+                }
+                reader.endObject();
+            }
+            reader.endObject();
+        } catch (Exception e) {
+            Log.w(TAG, "Invalid game props configuration", e);
+        }
+        return false;
+    }
+
+    private static boolean isTrickyStoreTarget(String content, String[] packages) {
+        if (TextUtils.isEmpty(content) || packages == null) {
+            return false;
+        }
+        final String trimmed = content.trim();
+        if (!trimmed.startsWith("[")) {
+            for (String rawLine : content.split("\\n")) {
+                String packageName = rawLine.trim();
+                if (packageName.isEmpty() || packageName.startsWith("#")) {
+                    continue;
+                }
+                if (packageName.endsWith("!") || packageName.endsWith("?")) {
+                    packageName = packageName.substring(0, packageName.length() - 1).trim();
+                }
+                if (containsPackage(packages, packageName)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        try (JsonReader reader = new JsonReader(new StringReader(trimmed))) {
+            reader.beginArray();
+            while (reader.hasNext()) {
+                reader.beginObject();
+                String packageName = null;
+                while (reader.hasNext()) {
+                    final String key = reader.nextName();
+                    if ("package".equals(key)) {
+                        packageName = reader.nextString();
+                    } else {
+                        reader.skipValue();
+                    }
+                }
+                reader.endObject();
+                if (containsPackage(packages, packageName)) {
+                    return true;
+                }
+            }
+            reader.endArray();
+        } catch (Exception e) {
+            Log.w(TAG, "Invalid TrickyStore target configuration", e);
+        }
+        return false;
+    }
+}
