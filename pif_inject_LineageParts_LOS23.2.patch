+    private static Pair<List<PifDevice>, String> fetchAvailableCanaryDevices() throws Exception {
+        try {
+            String versionsHtml = new String(
+                    readAll(new URL(GOOGLE_URL + "/about/versions").openStream()),
+                    StandardCharsets.UTF_8);
+            java.util.regex.Matcher vm = java.util.regex.Pattern
+                    .compile("https://developer\\.android\\.com/about/versions/(\\d+)")
+                    .matcher(versionsHtml);
+            java.util.TreeSet<Integer> knownVersions = new java.util.TreeSet<>();
+            while (vm.find()) {
+                knownVersions.add(Integer.parseInt(vm.group(1)));
+            }
+            if (knownVersions.isEmpty()) {
+                return Pair.of(new ArrayList<>(), null);
+            }
+
+            int maxVersion = knownVersions.last();
+            List<Integer> versions = new ArrayList<>();
+            versions.add(maxVersion + 1);
+            versions.addAll(knownVersions.descendingSet());
+
+            java.util.regex.Pattern rowPattern = java.util.regex.Pattern
+                    .compile("<tr id=\"([^\"]+)\">\\s*<td[^>]*>([^<]+)</td>",
+                            java.util.regex.Pattern.DOTALL);
+
+            for (int version : versions) {
+                try {
+                    String latestHtml = new String(
+                            readAll(new URL(GOOGLE_URL + "/about/versions/" + version).openStream()),
+                            StandardCharsets.UTF_8);
+                    java.util.regex.Matcher qm = java.util.regex.Pattern
+                            .compile("href=\"(/about/versions/" + version + "/qpr(\\d+)/download-ota)\"")
+                            .matcher(latestHtml);
+                    int bestQpr = -1;
+                    String qprPath = null;
+                    while (qm.find()) {
+                        int qpr = Integer.parseInt(qm.group(2));
+                        if (qpr > bestQpr) {
+                            bestQpr = qpr;
+                            qprPath = qm.group(1);
+                        }
+                    }
+                    if (qprPath == null) {
+                        continue;
+                    }
+
+                    String fiHtml = new String(readAll(new URL(GOOGLE_URL + qprPath).openStream()),
+                            StandardCharsets.UTF_8);
+
+                    List<PifDevice> devices = new ArrayList<>();
+                    java.util.Set<String> seen = new java.util.HashSet<>();
+                    java.util.regex.Matcher rm = rowPattern.matcher(fiHtml);
+                    while (rm.find()) {
+                        String device = rm.group(1);
+                        if (seen.contains(device)) {
+                            continue;
+                        }
+                        seen.add(device);
+                        String model = rm.group(2).trim();
+                        if (model.isEmpty()) {
+                            model = DEVICE_MODEL_MAP.getOrDefault(device, device);
+                        }
+                        devices.add(new PifDevice(device + "_beta", device, model, ""));
+                    }
+
+                    if (devices.isEmpty()) {
+                        continue;
+                    }
+
+                    String flashHtml = new String(readAll(new URL(FLASH_URL).openStream()),
+                            StandardCharsets.UTF_8);
+                    java.util.regex.Matcher km = java.util.regex.Pattern
+                            .compile("AIza[0-9A-Za-z_-]{35}")
+                            .matcher(flashHtml);
+                    String apiKey = km.find() ? km.group() : null;
+
+                    return Pair.of(devices, apiKey);
+                } catch (Exception e) {
+                    // continue
+                }
+            }
+            return Pair.of(new ArrayList<>(), null);
+        } catch (Exception e) {
+            Log.e(TAG, "Canary device fetch failed", e);
+            return Pair.of(new ArrayList<>(), null);
+        }
+    }
