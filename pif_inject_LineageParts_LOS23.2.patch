+    private static class Pair<A, B> {
+        final A first;
+        final B second;
+
+        Pair(A first, B second) {
+            this.first = first;
+            this.second = second;
+        }
+
+        static <A, B> Pair<A, B> of(A first, B second) {
+            return new Pair<>(first, second);
+        }
+    }
