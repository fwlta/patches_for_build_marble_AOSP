+ */
+package org.lineageos.lineageparts.pif;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+
+import org.json.JSONObject;
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+
+import java.io.InputStream;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+public class PlayIntegrityFix extends SettingsPreferenceFragment {
+
+    private static final String TAG = "PlayIntegrityFix";
+
+    private static final String PIF_CONFIG_KEY = "spoof_pif_config";
+    private static final String PIF_CONFIG_NAME = "pif.json";
+
+    private static final String GOOGLE_URL = "https://developer.android.com";
+    private static final String FLASH_URL = "https://flash.android.com";
+    private static final String FLASH_API = "https://content-flashstation-pa.googleapis.com/v1/builds";
+    private static final String PIXEL_BULLETIN_URL =
+            "https://source.android.com/docs/security/bulletin/pixel";
+
+    private static final String VENDING_PACKAGE = "com.android.vending";
+    private static final String GMS_PACKAGE = "com.google.android.gms";
+    private static final String PHOTOS_PACKAGE = "com.google.android.apps.photos";
+
+    private static final Map<String, String> DEVICE_MODEL_MAP = new LinkedHashMap<>();
+    static {
+        DEVICE_MODEL_MAP.put("oriole", "Pixel 6");
+        DEVICE_MODEL_MAP.put("raven", "Pixel 6 Pro");
+        DEVICE_MODEL_MAP.put("bluejay", "Pixel 6a");
+        DEVICE_MODEL_MAP.put("panther", "Pixel 7");
+        DEVICE_MODEL_MAP.put("cheetah", "Pixel 7 Pro");
+        DEVICE_MODEL_MAP.put("lynx", "Pixel 7a");
+        DEVICE_MODEL_MAP.put("shiba", "Pixel 8");
+        DEVICE_MODEL_MAP.put("tangorpro", "Pixel Tablet");
+        DEVICE_MODEL_MAP.put("felix", "Pixel Fold");
+        DEVICE_MODEL_MAP.put("husky", "Pixel 8 Pro");
+        DEVICE_MODEL_MAP.put("akita", "Pixel 8a");
+        DEVICE_MODEL_MAP.put("tokay", "Pixel 9");
+        DEVICE_MODEL_MAP.put("caiman", "Pixel 9 Pro");
+        DEVICE_MODEL_MAP.put("komodo", "Pixel 9 Pro XL");
+        DEVICE_MODEL_MAP.put("comet", "Pixel 9 Pro Fold");
+        DEVICE_MODEL_MAP.put("tegu", "Pixel 9a");
+        DEVICE_MODEL_MAP.put("frankel", "Pixel 10");
+        DEVICE_MODEL_MAP.put("blazer", "Pixel 10 Pro");
+        DEVICE_MODEL_MAP.put("mustang", "Pixel 10 Pro XL");
+        DEVICE_MODEL_MAP.put("rango", "Pixel 10 Pro Fold");
+        DEVICE_MODEL_MAP.put("stallion", "Pixel 10a");
+    }
+
+    private static final List<String> CONFIG_DETAILS_ORDER = new ArrayList<>();
+    static {
+        CONFIG_DETAILS_ORDER.add("MODEL");
+        CONFIG_DETAILS_ORDER.add("MANUFACTURER");
+        CONFIG_DETAILS_ORDER.add("BRAND");
+        CONFIG_DETAILS_ORDER.add("PRODUCT");
+        CONFIG_DETAILS_ORDER.add("DEVICE");
+        CONFIG_DETAILS_ORDER.add("FINGERPRINT");
+        CONFIG_DETAILS_ORDER.add("SECURITY_PATCH");
+        CONFIG_DETAILS_ORDER.add("ID");
+        CONFIG_DETAILS_ORDER.add("RELEASE");
+        CONFIG_DETAILS_ORDER.add("DEVICE_INITIAL_SDK_INT");
+    }
+
+    private enum PifChannel { LATEST_RELEASE, CANARY }
+
+    private static class PifDevice {
+        final String product;
+        final String device;
+        final String model;
+        final String otaUrl;
+
+        PifDevice(String product, String device, String model, String otaUrl) {
+            this.product = product;
+            this.device = device;
+            this.model = model;
+            this.otaUrl = otaUrl;
+        }
+    }
+
+    private static class PifFetchResult {
+        final String model;
+        final JSONObject pifData;
+        final String error;
+
+        private PifFetchResult(String model, JSONObject pifData, String error) {
+            this.model = model;
+            this.pifData = pifData;
+            this.error = error;
+        }
+
+        static PifFetchResult success(String model, JSONObject pifData) {
+            return new PifFetchResult(model, pifData, null);
+        }
+
+        static PifFetchResult error(String message) {
+            return new PifFetchResult(null, null, message);
+        }
+    }
+
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+    private final Handler mMainHandler = new Handler(Looper.getMainLooper());
+
+    private Map<String, String> mActiveConfigData = new LinkedHashMap<>();
+
+    private final ActivityResultLauncher<Intent> mImportLauncher =
+            registerForActivityResult(new ActivityResultContracts.StartActivityForResult(),
+                    result -> {
+                        if (result.getResultCode() == Activity.RESULT_OK
+                                && result.getData() != null
+                                && result.getData().getData() != null) {
+                            try {
+                                final String content;
+                                try (InputStream input = requireContext().getContentResolver()
+                                        .openInputStream(result.getData().getData())) {
+                                    content = new String(readAll(input), StandardCharsets.UTF_8);
+                                }
+                                final String normalized = normalizePifPayload(content);
+                                Settings.Secure.putString(requireContext().getContentResolver(),
+                                        PIF_CONFIG_KEY, normalized);
+                                restartPifPackages();
+                                toast(getString(R.string.pif_imported_as, PIF_CONFIG_NAME));
+                                refreshStatus();
+                            } catch (Exception e) {
+                                toast(getString(R.string.pif_failed, e.getMessage()));
+                            }
+                        }
+                    });
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.play_integrity_fix);
+
+        findPreference("pif_fetch_beta").setOnPreferenceClickListener(preference -> {
+            showChannelSelectionDialog();
+            return true;
+        });
+
+        findPreference("pif_import_config").setOnPreferenceClickListener(preference -> {
+            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType("*/*");
+            mImportLauncher.launch(intent);
+            return true;
+        });
+
+        findPreference("pif_delete_config").setOnPreferenceClickListener(preference -> {
+            showDeleteDialog();
+            return true;
+        });
+
+        refreshStatus();
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        mExecutor.shutdown();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshStatus();
+    }
+
+    private void refreshStatus() {
+        String content = Settings.Secure.getStringForUser(requireContext().getContentResolver(),
+                PIF_CONFIG_KEY, UserHandle.USER_CURRENT);
+        mActiveConfigData = !TextUtils.isEmpty(content) ? readConfigData(content)
+                : new LinkedHashMap<>();
+        boolean exists = !mActiveConfigData.isEmpty();
+
+        Preference activePref = findPreference("pif_active_config");
+        if (exists) {
+            String model = mActiveConfigData.get("MODEL");
+            String fingerprint = mActiveConfigData.get("FINGERPRINT");
+            activePref.setTitle(PIF_CONFIG_NAME);
+            if (!TextUtils.isEmpty(model)) {
+                String summary = "MODEL: " + model;
+                if (!TextUtils.isEmpty(fingerprint)) {
+                    summary += "\nFINGERPRINT: " + fingerprint;
+                }
+                activePref.setSummary(summary);
+            } else {
+                activePref.setSummary(getString(R.string.pif_config_loaded));
+            }
+        } else {
+            activePref.setTitle(getString(R.string.pif_active_config));
+            activePref.setSummary(getString(R.string.pif_no_config));
+        }
+
+        findPreference("pif_delete_config").setEnabled(exists);
+
+        populateConfigDetails(mActiveConfigData);
+    }
+
+    private void populateConfigDetails(Map<String, String> data) {
+        PreferenceCategory category = findPreference("pif_config_details_category");
+        if (category == null) {
+            return;
+        }
+        category.removeAll();
+
+        if (data.isEmpty()) {
+            return;
+        }
+
+        for (String key : CONFIG_DETAILS_ORDER) {
+            String value = data.get(key);
+            if (value == null) {
+                continue;
+            }
+            Preference pref = new Preference(requireContext());
+            pref.setTitle(key);
+            pref.setSummary(value);
+            pref.setSelectable(false);
+            category.addPreference(pref);
+        }
+
+        for (Map.Entry<String, String> entry : data.entrySet()) {
+            String key = entry.getKey();
+            if (CONFIG_DETAILS_ORDER.contains(key)
+                    || key.startsWith("spoof")
+                    || "DEBUG".equals(key)
+                    || "verboseLogs".equals(key)) {
+                continue;
+            }
+            Preference pref = new Preference(requireContext());
+            pref.setTitle(key);
+            pref.setSummary(entry.getValue());
+            pref.setSelectable(false);
+            category.addPreference(pref);
+        }
+    }
+
+    private void showDeleteDialog() {
+        new AlertDialog.Builder(requireContext())
+                .setTitle(getString(R.string.pif_delete_title, PIF_CONFIG_NAME))
+                .setMessage(R.string.pif_delete_message)
+                .setPositiveButton(R.string.pif_delete, (dialog, which) -> {
+                    try {
+                        Settings.Secure.putString(requireContext().getContentResolver(),
+                                PIF_CONFIG_KEY, null);
+                        restartPifPackages();
+                        toast(getString(R.string.pif_deleted, PIF_CONFIG_NAME));
+                        refreshStatus();
+                    } catch (Exception e) {
+                        toast(getString(R.string.pif_failed, e.getMessage()));
+                    }
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void showChannelSelectionDialog() {
+        final String[] channels = new String[] {
+                getString(R.string.pif_channel_latest_release),
+                getString(R.string.pif_channel_canary_release)
+        };
+        new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.pif_select_channel)
+                .setItems(channels, (dialog, which) -> {
+                    PifChannel channel = which == 0
+                            ? PifChannel.LATEST_RELEASE : PifChannel.CANARY;
+                    fetchDevicesForChannel(channel);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void fetchDevicesForChannel(PifChannel channel) {
+        Preference fetchPref = findPreference("pif_fetch_beta");
+        fetchPref.setSummary(getString(R.string.pif_fetching));
+        fetchPref.setEnabled(false);
+
+        mExecutor.execute(() -> {
+            try {
+                final List<PifDevice> devices;
+                final String apiKey;
+                if (channel == PifChannel.LATEST_RELEASE) {
+                    devices = fetchAvailableDevices();
+                    apiKey = null;
+                } else {
+                    Pair<List<PifDevice>, String> canary = fetchAvailableCanaryDevices();
+                    devices = canary.first;
+                    apiKey = canary.second;
+                }
+
+                mMainHandler.post(() -> {
+                    if (!isAdded()) {
+                        return;
+                    }
+                    if (devices.isEmpty()) {
+                        toast(getString(R.string.pif_failed, "No devices found"));
+                        return;
+                    }
+                    if (channel == PifChannel.CANARY && TextUtils.isEmpty(apiKey)) {
+                        toast(getString(R.string.pif_failed,
+                                "Failed to extract Flash Tool API key"));
+                        return;
+                    }
+
+                    final String[] modelNames = new String[devices.size()];
+                    for (int i = 0; i < devices.size(); i++) {
+                        modelNames[i] = devices.get(i).model;
+                    }
+
+                    new AlertDialog.Builder(requireContext())
+                            .setTitle(R.string.pif_select_device)
+                            .setItems(modelNames, (dialog, which) ->
+                                    generateAndSavePif(devices.get(which), channel, apiKey))
+                            .setNegativeButton(android.R.string.cancel, null)
+                            .show();
+                });
+            } catch (Exception e) {
+                mMainHandler.post(() -> {
+                    if (isAdded()) {
+                        toast(getString(R.string.pif_failed, e.getMessage()));
+                    }
+                });
+            } finally {
+                mMainHandler.post(() -> {
+                    if (isAdded()) {
+                        fetchPref.setSummary(getString(R.string.pif_fetch_pixel_beta_summary));
+                        fetchPref.setEnabled(true);
+                    }
+                });
+            }
+        });
+    }
+
+    private void generateAndSavePif(PifDevice device, PifChannel channel, String apiKey) {
+        Preference fetchPref = findPreference("pif_fetch_beta");
+        fetchPref.setSummary(getString(R.string.pif_generating));
+        fetchPref.setEnabled(false);
+
+        mExecutor.execute(() -> {
+            final PifFetchResult result;
+            try {
+                if (channel == PifChannel.LATEST_RELEASE) {
+                    result = buildPifFromDevice(device);
+                } else {
+                    result = buildCanaryPifFromDevice(device, apiKey == null ? "" : apiKey);
+                }
+            } catch (Exception e) {
+                mMainHandler.post(() -> {
+                    if (isAdded()) {
+                        toast(getString(R.string.pif_failed, e.getMessage()));
+                    }
+                });
+                return;
+            }
+
+            mMainHandler.post(() -> {
+                if (!isAdded()) {
+                    return;
+                }
+                if (result.error == null) {
+                    try {
+                        Settings.Secure.putString(requireContext().getContentResolver(),
+                                PIF_CONFIG_KEY, result.pifData.toString(2));
+                        restartPifPackages();
+                        toast(getString(R.string.pif_fetched_model, result.model));
+                        refreshStatus();
+                    } catch (Exception e) {
+                        toast(getString(R.string.pif_failed, e.getMessage()));
+                    }
+                } else {
+                    toast(getString(R.string.pif_failed, result.error));
+                }
+                fetchPref.setSummary(getString(R.string.pif_fetch_pixel_beta_summary));
+                fetchPref.setEnabled(true);
+            });
+        });
+    }
+
+    private void killPackage(String pkg) {
+        try {
+            ActivityManager am = (ActivityManager) requireContext()
+                    .getSystemService(Context.ACTIVITY_SERVICE);
+            am.forceStopPackage(pkg);
+        } catch (Exception e) {
+            // Ignore
+        }
+    }
+
+    private void restartPifPackages() {
+        killPackage(GMS_PACKAGE);
+        killPackage(VENDING_PACKAGE);
+    }
+
+    private void toast(String msg) {
+        Toast.makeText(requireContext(), msg, Toast.LENGTH_SHORT).show();
+    }
+
+    private static byte[] readAll(InputStream input) throws Exception {
+        java.io.ByteArrayOutputStream buffer = new java.io.ByteArrayOutputStream();
+        byte[] data = new byte[4096];
+        int nRead;
+        while ((nRead = input.read(data, 0, data.length)) != -1) {
+            buffer.write(data, 0, nRead);
+        }
+        return buffer.toByteArray();
+    }
+
+    /**
+     * Reads the config from a JSON string (stored in Settings.Secure).
+     * Also handles legacy prop-format strings in case an old value is present.
+     */
+    private static Map<String, String> readConfigData(String content) {
+        Map<String, String> result = new LinkedHashMap<>();
+        try {
+            String trimmed = content.trim();
+            if (trimmed.startsWith("{")) {
+                JSONObject json = new JSONObject(trimmed);
+                for (java.util.Iterator<String> it = json.keys(); it.hasNext(); ) {
+                    String key = it.next();
+                    result.put(key, json.optString(key, ""));
+                }
+            } else {
+                String[] lines = trimmed.split("\n");
+                for (String line : lines) {
+                    String l = line.trim();
+                    if (l.isEmpty() || l.startsWith("#") || l.startsWith("//")) {
+                        continue;
+                    }
+                    int eq = l.indexOf('=');
+                    if (eq > 0) {
+                        result.put(l.substring(0, eq).trim(), l.substring(eq + 1).trim());
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read config", e);
+            return new LinkedHashMap<>();
+        }
+        return result;
+    }
+
+    /**
+     * Normalises an imported PIF payload (JSON or prop-format) to a JSON string
+     * suitable for storage in Settings.Secure.
+     */
+    private static String normalizePifPayload(String raw) throws Exception {
+        String trimmed = raw.trim();
+        if (trimmed.isEmpty()) {
+            throw new IllegalArgumentException("Configuration is empty");
+        }
+
+        final JSONObject json;
+        if (trimmed.startsWith("{")) {
+            json = new JSONObject(trimmed);
+        } else {
+            json = new JSONObject();
+            String[] lines = trimmed.split("\n");
+            for (String line : lines) {
+                String stripped = line.trim();
+                if (stripped.isEmpty() || stripped.startsWith("#") || stripped.startsWith("//")) {
+                    continue;
+                }
+                int eq = stripped.indexOf('=');
+                if (eq > 0) {
+                    String key = stripped.substring(0, eq).trim();
+                    String value = stripped.substring(eq + 1).trim();
+                    int hash = value.indexOf('#');
+                    if (hash > 0) {
+                        value = value.substring(0, hash).trim();
+                    }
+                    if (!key.isEmpty()) {
+                        json.put(key, value);
+                    }
+                }
+            }
+        }
+
+        if (json.length() == 0) {
+            throw new IllegalArgumentException("No PIF fields found");
+        }
+        return json.toString(2);
+    }
+
+    private static String fetchPartialUrl(String url, int maxBytes) throws Exception {
+        java.net.HttpURLConnection conn =
+                (java.net.HttpURLConnection) new URL(url).openConnection();
+        conn.setConnectTimeout(15000);
+        conn.setReadTimeout(15000);
+        try (InputStream input = conn.getInputStream()) {
+            byte[] buf = new byte[512];
+            StringBuilder sb = new StringBuilder();
+            int total = 0;
+            while (total < maxBytes) {
+                int read = input.read(buf);
+                if (read == -1) {
+                    break;
+                }
+                sb.append(new String(buf, 0, read, StandardCharsets.ISO_8859_1));
+                total += read;
+            }
+            return sb.toString();
+        }
+    }
+
+    /**
+     * Phase 1: Scrape Google developer site to find all available beta devices.
+     */
+    private static List<PifDevice> fetchAvailableDevices() throws Exception {
+        String versionsHtml = new String(
+                readAll(new URL(GOOGLE_URL + "/about/versions").openStream()),
+                StandardCharsets.UTF_8);
+        java.util.regex.Matcher vm = java.util.regex.Pattern
+                .compile("https://developer\\.android\\.com/about/versions/(\\d+)")
+                .matcher(versionsHtml);
+        java.util.TreeSet<Integer> knownVersions = new java.util.TreeSet<>();
+        while (vm.find()) {
+            knownVersions.add(Integer.parseInt(vm.group(1)));
+        }
+        if (knownVersions.isEmpty()) {
+            return new ArrayList<>();
+        }
+
+        int maxVersion = knownVersions.last();
+        List<Integer> versions = new ArrayList<>();
+        versions.add(maxVersion + 1);
+        versions.addAll(knownVersions.descendingSet());
+
+        for (int version : versions) {
+            try {
+                String downloadUrl = GOOGLE_URL + "/about/versions/" + version + "/download-ota";
+                String otaHtml = new String(readAll(new URL(downloadUrl).openStream()),
+                        StandardCharsets.UTF_8);
+                java.util.regex.Matcher om = java.util.regex.Pattern
+                        .compile("href=\"(https://dl\\.google\\.com/[^\"]*ota/([^/\"]+_beta)[^\"]*?)\"")
+                        .matcher(otaHtml);
+                List<PifDevice> devices = new ArrayList<>();
+                java.util.Set<String> seen = new java.util.HashSet<>();
+                while (om.find()) {
+                    String otaUrl = om.group(1);
+                    String product = om.group(2);
+                    String device = product.replace("_beta", "");
+                    if (seen.contains(device)) {
+                        continue;
+                    }
+                    seen.add(device);
+                    String model = DEVICE_MODEL_MAP.getOrDefault(device, device);
+                    devices.add(new PifDevice(product, device, model, otaUrl));
+                }
+                if (!devices.isEmpty()) {
+                    return devices;
+                }
+            } catch (Exception e) {
+                // continue
+            }
+        }
+        return new ArrayList<>();
+    }
+
+    /**
+     * Phase 2: Fetch OTA metadata for a specific device and build pif JSON.
+     */
+    private static PifFetchResult buildPifFromDevice(PifDevice pifDevice) {
+        try {
+            String partial = fetchPartialUrl(pifDevice.otaUrl, 4096);
+
+            java.util.regex.Matcher fm = java.util.regex.Pattern
+                    .compile("post-build=(.*)")
+                    .matcher(partial);
+            if (!fm.find()) {
+                return PifFetchResult.error("Could not extract fingerprint");
+            }
+            String fingerprint = fm.group(1).trim();
+
+            java.util.regex.Matcher sm = java.util.regex.Pattern
+                    .compile("security-patch-level=(.*)")
+                    .matcher(partial);
+            if (!sm.find()) {
+                return PifFetchResult.error("Could not extract security patch");
+            }
+            String securityPatch = sm.group(1).trim();
+
+            String[] fpParts = fingerprint.split("/");
+            String release = fpParts.length > 2
+                    ? fpParts[2].substring(fpParts[2].indexOf(':') + 1) : "";
+            String buildId = fpParts.length > 3 ? fpParts[3] : "";
+
+            JSONObject pifJson = new JSONObject();
+            pifJson.put("TYPE", "user");
+            pifJson.put("TAGS", "release-keys");
+            pifJson.put("ID", buildId);
+            pifJson.put("BRAND", "google");
+            pifJson.put("DEVICE", pifDevice.device);
+            pifJson.put("FINGERPRINT", fingerprint);
+            pifJson.put("MANUFACTURER", "Google");
+            pifJson.put("MODEL", pifDevice.model);
+            pifJson.put("PRODUCT", pifDevice.product);
+            pifJson.put("RELEASE", release);
+            pifJson.put("SECURITY_PATCH", securityPatch);
+            pifJson.put("DEVICE_INITIAL_SDK_INT", "21");
+            pifJson.put("DEBUG", false);
+            pifJson.put("SDK_INT", "32");
+            return PifFetchResult.success(pifDevice.model, pifJson);
+        } catch (Exception e) {
+            return PifFetchResult.error("Failed: " + e.getMessage());
+        }
+    }
