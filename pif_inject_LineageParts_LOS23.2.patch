+    private static PifFetchResult buildCanaryPifFromDevice(PifDevice pifDevice, String apiKey) {
+        try {
+            if (apiKey.isEmpty()) {
+                return PifFetchResult.error("Flash Tool API key unavailable");
+            }
+
+            String buildsUrl = FLASH_API + "?product=" + pifDevice.product + "&key=" + apiKey;
+            java.net.HttpURLConnection buildsConn =
+                    (java.net.HttpURLConnection) new URL(buildsUrl).openConnection();
+            buildsConn.setRequestProperty("Referer", FLASH_URL);
+            buildsConn.setRequestProperty("X-Goog-Api-Key", apiKey);
+            buildsConn.setConnectTimeout(15000);
+            buildsConn.setReadTimeout(15000);
+
+            String buildsJson;
+            try (InputStream input = buildsConn.getInputStream()) {
+                buildsJson = new String(readAll(input), StandardCharsets.UTF_8);
+            }
+
+            JSONObject root = new JSONObject(buildsJson);
+            org.json.JSONArray buildsArray = root.optJSONArray("flashstationBuild");
+            if (buildsArray == null) {
+                return PifFetchResult.error("No flashstationBuild array in Flash Tool response");
+            }
+
+            String id = null;
+            String incremental = null;
+            String canaryId = null;
+
+            for (int i = buildsArray.length() - 1; i >= 0; i--) {
+                JSONObject b = buildsArray.optJSONObject(i);
+                if (b == null) {
+                    continue;
+                }
+                JSONObject meta = b.optJSONObject("previewMetadata");
+                if (meta == null || !meta.optBoolean("canary")) {
+                    continue;
+                }
+                String rc = b.optString("releaseCandidateName");
+                String bid = b.optString("buildId");
+                if (rc.isEmpty() || bid.isEmpty()) {
+                    continue;
+                }
+                id = rc;
+                incremental = bid;
+                String mId = meta.optString("id");
+                canaryId = mId.contains("canary-") ? mId : null;
+                break;
+            }
+
+            if (id == null || incremental == null) {
+                return PifFetchResult.error("No canary build found for " + pifDevice.product);
+            }
+
+            String fingerprint = "google/" + pifDevice.product + "/" + pifDevice.device
+                    + ":CANARY/" + id + "/" + incremental + ":user/release-keys";
+
+            String canaryMonth;
+            if (canaryId == null) {
+                return PifFetchResult.error("Failed to derive canary month id");
+            }
+            java.util.regex.Matcher cm = java.util.regex.Pattern
+                    .compile("canary-(\\d{4})(\\d{2})")
+                    .matcher(canaryId);
+            if (!cm.find()) {
+                return PifFetchResult.error("Failed to derive canary month id");
+            }
+            canaryMonth = cm.group(1) + "-" + cm.group(2);
+
+            String securityPatch;
+            try {
+                String bulletinHtml = new String(
+                        readAll(new URL(PIXEL_BULLETIN_URL).openStream()),
+                        StandardCharsets.UTF_8);
+                java.util.regex.Matcher bm = java.util.regex.Pattern
+                        .compile("<td>(" + canaryMonth + "-\\d{2})</td>")
+                        .matcher(bulletinHtml);
+                securityPatch = bm.find() ? bm.group(1) : canaryMonth + "-05";
+            } catch (Exception e) {
+                Log.d(TAG, "Bulletin fetch failed, using estimated patch: " + e.getMessage());
+                securityPatch = canaryMonth + "-05";
+            }
+
+            JSONObject pifJson = new JSONObject();
+            pifJson.put("TYPE", "user");
+            pifJson.put("TAGS", "release-keys");
+            pifJson.put("ID", id);
+            pifJson.put("BRAND", "google");
+            pifJson.put("DEVICE", pifDevice.device);
+            pifJson.put("FINGERPRINT", fingerprint);
+            pifJson.put("MANUFACTURER", "Google");
+            pifJson.put("MODEL", pifDevice.model);
+            pifJson.put("PRODUCT", pifDevice.product);
+            pifJson.put("RELEASE", "CANARY");
+            pifJson.put("SECURITY_PATCH", securityPatch);
+            pifJson.put("DEVICE_INITIAL_SDK_INT", "32");
+            pifJson.put("DEBUG", false);
+            pifJson.put("SDK_INT", "32");
+            return PifFetchResult.success(pifDevice.model, pifJson);
+        } catch (Exception e) {
+            return PifFetchResult.error("Failed: " + e.getMessage());
+        }
+    }
